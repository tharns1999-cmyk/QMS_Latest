{
  "name": "qms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-local.js && wrangler d1 execute DB --local --file .wrangler/seed-local.sql",
    "test": "jest legacy && vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
