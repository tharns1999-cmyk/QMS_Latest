{
  "name": "qms-portal",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "node scripts/require-api-url.mjs && vite build",
    "lint": "oxlint src tests e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run lint && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "dayjs": "^1.11.23",
